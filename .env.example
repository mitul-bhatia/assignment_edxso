# Copy to .env and add your own keys. Never commit .env.
YOUTUBE_API_KEY=your-youtube-data-api-key
GROQ_API_KEY=your-groq-key-optional
GEMINI_API_KEY=your-gemini-api-key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash
CLASSIFIER_PROVIDER=auto
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_CLASSIFIER_PAUSE_SECONDS=2
GEMINI_PERSONALIZATION_MODEL=gemini-3.5-flash
# If Python cannot find system CA certificates on macOS, set SSL_CERT_FILE=/etc/ssl/cert.pem

# Optional: real email sending (python main.py send --live ...). Leave empty to stay in dry-run.
# Gmail: enable 2-step verification, create an App Password, use smtp.gmail.com / 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: models tried in order if the primary hits its daily quota (default: the classifier model)
# GEMINI_PERSONALIZATION_FALLBACK_MODELS=gemini-3.5-flash-lite
# GEMINI_MIN_INTERVAL_SECONDS=6
